{
  "name": "@rvitaliy/quantix",
  "version": "2.0.0",
  "description": "Streaming-first technical indicators in modern TypeScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rvitaliy/quantix.git"
  },
  "exports": "./mod.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "exclude": [
    ".idea/"
  ],
  "fmt": {
    "useTabs": false,
    "lineWidth": 150,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  },
  "publish": {
    "include": [
      ".github/SECURITY.md",
      "README.md",
      "examples/**/*.ts",
      "examples/README.md",
      "mod.ts",
      "src/**/*.ts",
      "LICENSE"
    ]
  },
  "tasks": {
    "audit": "deno audit --frozen",
    "coverage": "deno test --clean --coverage=coverage --coverage-raw-data-only ./tests && deno coverage --detailed --exclude='tests/' --threshold=80 coverage",
    "doc": "deno doc --lint mod.ts",
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "publish:dry-run": "deno publish --dry-run --allow-dirty",
    "test": "deno test ./tests",
    "typecheck": "deno check mod.ts examples/*.ts .github/scripts/*.ts",
    "check": "deno task audit && deno task fmt && deno task lint && deno task typecheck && deno task doc && deno task test && deno task publish:dry-run"
  }
}
